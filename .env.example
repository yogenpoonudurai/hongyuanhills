# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://hongyuanhills.com

# ---------------------------------------------------------------------------
# Contact / WhatsApp
# Use international format, digits only, no "+" or spaces.
# Example: Malaysia 60 17-733 3385 -> 60177333385
# Leave blank until the client supplies the final numbers. The UI falls back
# to the current live numbers in lib/contact.ts so nothing renders broken.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_GENERAL=
NEXT_PUBLIC_WHATSAPP_BOOKING=
NEXT_PUBLIC_WHATSAPP_EMERGENCY=
NEXT_PUBLIC_PHONE_24H=
NEXT_PUBLIC_PHONE_OFFICE=
NEXT_PUBLIC_PHONE_OFFICE_DISPLAY=607-772 3399
NEXT_PUBLIC_EMAIL=

# ---------------------------------------------------------------------------
# Forms / email delivery (server-side)
# ---------------------------------------------------------------------------
LEAD_NOTIFICATION_EMAIL=
FROM_EMAIL=
RESEND_API_KEY=
ALLOWED_ORIGINS=https://hongyuanhills.com,https://www.hongyuanhills.com
FORM_ENABLED=true
# Use "noop" in CI/preview so no real emails are sent.
EMAIL_TRANSPORT=resend

# ---------------------------------------------------------------------------
# Spam protection (Cloudflare Turnstile)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
